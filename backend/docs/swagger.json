{
    "swagger": "2.0",
    "info": {
        "description": "REST API кредитного кабинета для юрлиц и ИП и рабочего места банка.",
        "title": "Умный кредитный кабинет API",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/api/v1",
    "paths": {
        "/applications/{id}/company-profile": {
            "get": {
                "description": "Профиль из клиентской базы банка, сверенный с реестрами. Только для чтения.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "applications"
                ],
                "summary": "Данные о компании для заявки",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID заявки",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/company.profileResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorBody"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorBody"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorBody"
                        }
                    },
                    "502": {
                        "description": "Bad Gateway",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorBody"
                        }
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Вход по логину и паролю",
                "parameters": [
                    {
                        "description": "Учётные данные",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/identity.loginRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/identity.loginResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorBody"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorBody"
                        }
                    }
                }
            }
        },
        "/auth/logout": {
            "post": {
                "tags": [
                    "auth"
                ],
                "summary": "Завершить сессию",
                "responses": {
                    "204": {
                        "description": "No Content"
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorBody"
                        }
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "auth"
                ],
                "summary": "Текущий пользователь",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/identity.meResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/httpx.ErrorBody"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "company.candidateDTO": {
            "type": "object",
            "properties": {
                "fullName": {
                    "type": "string",
                    "example": "Смирнов Олег Викторович"
                },
                "personId": {
                    "type": "string",
                    "example": "p-1"
                },
                "roles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/shared.PersonRole"
                    },
                    "example": [
                        "HEAD",
                        "FOUNDER"
                    ]
                }
            }
        },
        "company.founderDTO": {
            "type": "object",
            "properties": {
                "fullName": {
                    "type": "string",
                    "example": "Смирнов Олег Викторович"
                },
                "personId": {
                    "type": "string",
                    "example": "p-1"
                },
                "share": {
                    "type": "number",
                    "example": 100
                }
            }
        },
        "company.girboDTO": {
            "type": "object",
            "properties": {
                "accounted": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "company.okvedDTO": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string",
                    "example": "10.71"
                },
                "name": {
                    "type": "string",
                    "example": "Производство хлеба"
                }
            }
        },
        "company.personRefDTO": {
            "type": "object",
            "properties": {
                "fullName": {
                    "type": "string",
                    "example": "Смирнов Олег Викторович"
                },
                "personId": {
                    "type": "string",
                    "example": "p-1"
                }
            }
        },
        "company.profileResponse": {
            "type": "object",
            "properties": {
                "actualAddress": {
                    "type": "string",
                    "example": "г. Москва, ул. Складская, 3"
                },
                "founders": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/company.founderDTO"
                    }
                },
                "girbo": {
                    "description": "null у ИП: ГИР БО ведётся только по юрлицам",
                    "allOf": [
                        {
                            "$ref": "#/definitions/company.girboDTO"
                        }
                    ]
                },
                "guarantorCandidates": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/company.candidateDTO"
                    }
                },
                "head": {
                    "$ref": "#/definitions/company.personRefDTO"
                },
                "okved": {
                    "$ref": "#/definitions/company.okvedDTO"
                },
                "regAddress": {
                    "type": "string",
                    "example": "г. Москва, ул. Пекарская, 7"
                },
                "source": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/shared.CheckSource"
                    },
                    "example": [
                        "BANK",
                        "EGRUL"
                    ]
                },
                "taxRegime": {
                    "type": "string",
                    "example": "USN_INCOME_MINUS_EXPENSES"
                },
                "turnover": {
                    "$ref": "#/definitions/company.turnoverDTO"
                }
            }
        },
        "company.turnoverDTO": {
            "type": "object",
            "properties": {
                "avgMonthlyIncome": {
                    "type": "integer",
                    "example": 1840000
                },
                "periodMonths": {
                    "type": "integer",
                    "example": 12
                },
                "source": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/shared.CheckSource"
                        }
                    ],
                    "example": "BANK_ACCOUNTS"
                }
            }
        },
        "httpx.ErrorBody": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "fields": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/httpx.FieldError"
                    }
                },
                "message": {
                    "type": "string"
                },
                "traceId": {
                    "type": "string"
                }
            }
        },
        "httpx.FieldError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "field": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "identity.companyDTO": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "example": "c-1"
                },
                "inn": {
                    "type": "string",
                    "example": "7712345678"
                },
                "name": {
                    "type": "string",
                    "example": "ООО «Северная пекарня»"
                }
            }
        },
        "identity.loginRequest": {
            "type": "object",
            "required": [
                "login",
                "password"
            ],
            "properties": {
                "login": {
                    "type": "string",
                    "example": "smirnov"
                },
                "password": {
                    "type": "string",
                    "example": "demo123"
                }
            }
        },
        "identity.loginResponse": {
            "type": "object",
            "properties": {
                "redirect": {
                    "type": "string",
                    "example": "/"
                },
                "user": {
                    "$ref": "#/definitions/identity.userDTO"
                }
            }
        },
        "identity.meResponse": {
            "type": "object",
            "properties": {
                "company": {
                    "$ref": "#/definitions/identity.companyDTO"
                },
                "fullName": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "position": {
                    "type": "string"
                },
                "role": {
                    "$ref": "#/definitions/shared.Role"
                }
            }
        },
        "identity.userDTO": {
            "type": "object",
            "properties": {
                "companyId": {
                    "type": "string",
                    "example": "c-1"
                },
                "fullName": {
                    "type": "string",
                    "example": "Смирнов Олег Викторович"
                },
                "id": {
                    "type": "string",
                    "example": "u-1"
                },
                "position": {
                    "type": "string",
                    "example": "Генеральный директор"
                },
                "role": {
                    "allOf": [
                        {
                            "$ref": "#/definitions/shared.Role"
                        }
                    ],
                    "example": "CLIENT"
                }
            }
        },
        "shared.CheckSource": {
            "type": "string",
            "enum": [
                "BANK",
                "BANK_ACCOUNTS",
                "EGRUL",
                "TRANSPARENT_BUSINESS",
                "BKI",
                "FNS",
                "GIRBO",
                "COURTS"
            ],
            "x-enum-comments": {
                "SourceEGRUL": "ЕГРЮЛ или ЕГРИП — по типу компании",
                "SourceGIRBO": "только ООО"
            },
            "x-enum-descriptions": [
                "",
                "",
                "ЕГРЮЛ или ЕГРИП — по типу компании",
                "",
                "",
                "",
                "только ООО",
                ""
            ],
            "x-enum-varnames": [
                "SourceBank",
                "SourceBankAccounts",
                "SourceEGRUL",
                "SourceTransparentBusiness",
                "SourceBKI",
                "SourceFNS",
                "SourceGIRBO",
                "SourceCourts"
            ]
        },
        "shared.PersonRole": {
            "type": "string",
            "enum": [
                "HEAD",
                "FOUNDER",
                "REPRESENTATIVE"
            ],
            "x-enum-varnames": [
                "PersonHead",
                "PersonFounder",
                "PersonRepresentative"
            ]
        },
        "shared.Role": {
            "type": "string",
            "enum": [
                "CLIENT",
                "BANK_OFFICER"
            ],
            "x-enum-varnames": [
                "RoleClient",
                "RoleBankOfficer"
            ]
        }
    }
}